            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "8443,636,993",
              "from": "staff",
              "to": "servers",
              "note": "İdari personel yalnızca ERP, LDAPS ve IMAPS sunucularına erişir."
            },
            {
              "action": "allow",
              "direction": "forward",
              "proto": "tcp",
              "port": "22,443",
              "from": "software",
              "to": "servers",
              "note": "Yazılım ekibi Git ve CI/CD sunucularına erişir; idari VLAN'a erişemez."
            },
