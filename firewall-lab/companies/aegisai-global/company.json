            }
          ],
          "rules": [
            {
              "action": "deny",
              "direction": "forward",
              "proto": "any",
              "from": "private-source-from-internet",
              "to": "any-site",
              "note": "Spoof koruması: internetten gelen özel (RFC1918) kaynak adresler sahtedir."
            },
            {
              "action": "limit",
              "direction": "in",
              "proto": "tcp",
              "port": 443,
              "from": "Internet",
              "to": "dmz-web",
